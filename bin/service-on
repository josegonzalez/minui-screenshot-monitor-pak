#!/bin/sh
BIN_DIR="$(dirname "$0")"
PAK_DIR="$(dirname "$BIN_DIR")"
PAK_NAME="$(basename "$PAK_DIR")"
PAK_NAME="${PAK_NAME%.*}"
set -x

echo "$0" "$@"
cd "$PAK_DIR" || exit 1

architecture=arm
if uname -m | grep -q '64'; then
    architecture=arm64
fi

export PATH="$PAK_DIR/bin/$architecture:$PAK_DIR/bin/$PLATFORM:$PAK_DIR/bin:$PATH"

main() {
    cd "$SDCARD_PATH" || return 1

    raw_hotkey=""
    if [ -f "$USERDATA_PATH/$PAK_NAME/hotkey" ]; then
        raw_hotkey="$(cat "$USERDATA_PATH/$PAK_NAME/hotkey")"
    fi

    # exit 2 lets launch.sh tell an invalid hotkey apart from other failures
    if ! hotkey="$(normalize-hotkey "$raw_hotkey")"; then
        echo "Invalid hotkey: $raw_hotkey"
        return 2
    fi

    if [ -z "$hotkey" ]; then
        hotkey="btn_l2"
    fi

    PLATFORM="$PLATFORM" HOTKEY="$hotkey" screenshot-monitor &
}

main "$@"
