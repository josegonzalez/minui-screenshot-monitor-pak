#!/bin/sh
BIN_DIR="$(dirname "$(dirname "$0")")"
PAK_DIR="$(dirname "$BIN_DIR")"
PAK_NAME="$(basename "$PAK_DIR")"
PAK_NAME="${PAK_NAME%.*}"
[ -f "$USERDATA_PATH/$PAK_NAME/debug" ] && set -x

rm -f "$LOGS_PATH/$PAK_NAME.service.txt"
exec >>"$LOGS_PATH/$PAK_NAME.service.txt"
exec 2>&1

architecture=arm
if uname -m | grep -q '64'; then
    architecture=arm64
fi

export PATH="$PAK_DIR/bin/$architecture:$PAK_DIR/bin/$PLATFORM:$PAK_DIR/bin:$PATH"

main() {
    # minui-btntest treats `all` with no buttons as always pressed
    if [ -z "$HOTKEY" ]; then
        echo "No hotkey configured"
        return 1
    fi

    echo "Starting screenshot monitor on $HOTKEY..."
    chmod +x "$PAK_DIR/bin/screenshot"
    chmod +x "$PAK_DIR/bin/$PLATFORM/minui-btntest"

    # service-off kills this script, so stop the watcher along with it
    btntest_pid=""
    trap 'kill -TERM "$btntest_pid" 2>/dev/null; wait "$btntest_pid"; exit 0' TERM INT HUP

    minui-btntest watch is_pressed all "$HOTKEY" -- screenshot &
    btntest_pid=$!
    wait "$btntest_pid"
    exit_code=$?

    # exit code 10 is a minui-btntest parse error
    if [ "$exit_code" -eq 10 ]; then
        echo "Invalid hotkey: $HOTKEY"
    else
        echo "minui-btntest exited unexpectedly ($exit_code)"
    fi

    return "$exit_code"
}

main "$@"
